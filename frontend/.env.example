# Backend base URL for legacy /api/* routes.
# Example: https://credit-intel-backend.vercel.app
NEXT_PUBLIC_API_URL=

# Backend root URL for pipeline stage endpoints such as /entity-onboard.
# Usually the same value as NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_INGESTOR_URL=

# Optional: use this if you want to provide a full /api URL directly.
# If set, it takes precedence over NEXT_PUBLIC_API_URL.
# Example: https://credit-intel-backend.vercel.app/api
NEXT_PUBLIC_API_BASE=
